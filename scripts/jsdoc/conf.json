{
  "tags": {
    "allowUnknownTags": false
  },
  "source": {
    "include": ["src/sdk"],
    "exclude": [],
    "includePattern": ".+\\.js(doc)?$",
    "excludePattern": "(^|\\/|\\\\)_"
  },
  "plugins": [],
  "templates": {
    "cleverLinks": true,
    "default": {
      "outputSourceFiles": false
    }
  },
  "opts": {
    "destination": "Build/Documentation",
    "template": "./scripts/jsdoc/jsdoc_template",
    "recurse": true
  }
}
