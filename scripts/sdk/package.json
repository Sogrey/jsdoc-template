{
  "name": "{{SDK_NAME}}",
  "version": "1.0.0",
  "description": "JSDoc SDK - 一个用于生成和管理几何图形的工具库",
  "main": "{{SDK_NAME}}.cjs.js",
  "module": "{{SDK_NAME}}.es.js",
  "types": "{{SDK_NAME}}.d.ts",
  "exports": {
    ".": {
      "import": "./{{SDK_NAME}}.es.js",
      "require": "./{{SDK_NAME}}.cjs.js",
      "types": "./{{SDK_NAME}}.d.ts"
    }
  },
  "browser": "{{SDK_NAME}}.umd.js",
  "files": [
    "*.js",
    "*.js.map",
    "*.d.ts",
    "README.md"
  ],
  "keywords": [
    "jsdoc",
    "sdk",
    "geometry",
    "shapes",
    "canvas",
    "graphics",
    "event-emitter"
  ],
  "author": "Sogrey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sogrey/jsdoc-template.git"
  },
  "bugs": {
    "url": "https://github.com/Sogrey/jsdoc-template/issues"
  },
  "homepage": "https://github.com/Sogrey/jsdoc-template#readme"
}
